# --- repository, storage, execution -------------------------------------------
ASE_REPOSITORY_ROOT=/workspace/repositories
ASE_DATA_DIR=.ase
ASE_DATABASE_PATH=/data/ase.db
ASE_FEEDBACK_PATH=/data/feedback.db
# local | docker (alias: container). Production validation rejects "local".
ASE_EXECUTION_BACKEND=container
ASE_SANDBOX_NETWORK=false
ASE_DOCKER_IMAGE=ase-sandbox:latest

# --- models -------------------------------------------------------------------
# Anthropic Messages API used by the issue-to-PR agent, test generation and CI triage.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ASE_PLANNER_MODEL=claude-opus-5
ASE_CODER_MODEL=claude-sonnet-5
ASE_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# Optional code embeddings for semantic retrieval (hashing embeddings are the fallback).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-3
# OpenAI-compatible gateway used by the async planner / test-proposal adapters.
ASE_MODEL_ENDPOINT=http://model-gateway/v1/chat/completions
ASE_MODEL_NAME=replace-me
ASE_MODEL_API_KEY=

# --- per-run budgets (the run stops, and is marked FAILED, when any is exceeded) ---
ASE_MAX_ITERATIONS=6
ASE_MAX_TOKENS=400000
ASE_MAX_USD=3.0
ASE_MAX_SECONDS=900

# --- GitHub -------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
